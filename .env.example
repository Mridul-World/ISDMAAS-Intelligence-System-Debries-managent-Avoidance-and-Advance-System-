# ISDMAAS credential template.
#
# Copy to a file your shell sources (never commit it; *.env is gitignored) and
# fill in your own values. Nothing in this repository should ever contain a real
# credential - a previous version inlined them in source and in dd.env, and they
# are consequently present in every historical commit and must be treated as
# compromised. See docs/SECURITY_AUDIT.md for the rotation record.

# --- Space-Track (https://www.space-track.org) -------------------------------
SPACETRACK_USER=
SPACETRACK_PASS=

# --- ESA DISCOS (https://discosweb.esoc.esa.int) ------------------------------
DISCOS_TOKEN=

# --- Copernicus Data Space (https://dataspace.copernicus.eu) ------------------
CDSE_USER=
CDSE_PASS=

# --- ISDMAAS service ----------------------------------------------------------
# Required when ISDMAAS_ENV=production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ISDMAAS_ENV=development
ISDMAAS_SECRET_KEY=
ISDMAAS_CORS_ORIGINS=
ISDMAAS_DATA_DIR=
