# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ---- Large data (DO NOT COMMIT — external drive backup only) ----
data/esa_pod/
data/*.EOF
data/*.SP3
*.csv.gz
socrates_dump.html

# ---- Trained model weights (use Git LFS or exclude; see README §Repo Hygiene) ----
models/**/*.pt
models/**/*.pth
models/**/*.h5
models/**/*.ckpt

# ---- Secrets / credentials ----
.env
*_credentials.json
space_track_login.txt
# Operator accounts, password hashes and session tokens. The legacy JSON store
# and both SQLite databases were previously committed; never track them again.
phase11/auth_store.json
phase11/auth_store.json.tmp
phase11/isdmaas_ops.db
**/isdmaas_auth.db
**/isdmaas_auth.db-*
**/isdmaas_ops.db
**/isdmaas_ops.db-*

# ---- Local caches (regenerated on demand, not source) ----
phase11/data/
# ...except the offline fallback catalog, which is public element-set data and
# lets the console start without network access.
!phase11/data/catalog_active.tle
phase11/catalog_cache.json
**/*.db-journal
**/*.db-wal
**/*.db-shm

# ---- Backups made by patch scripts ----
*.bak

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Generated/output artifacts (regenerate, don't version) ----
*.pdf
page-*.jpg
test_active.txt
test_debris.txt

# ---- Trained weights produced by phase55 trainers ----
# Per Repo Hygiene §7.1: weights go to Git LFS or an external store, never
# straight into the repository. The JSON reports beside them are committed —
# they are small and they are the evidence.
phase55/model/*.pt
!phase55/model/.gitkeep

# ---- Local credential shells (NEVER commit) ----
dd.env
*.env
!.env.example
